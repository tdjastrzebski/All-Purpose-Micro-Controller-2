{
    "version": 4,
    "configurations": [
        {
            "name": "gcc",
            "intelliSenseMode": "gcc-arm",
            "cStandard": "c23",
            "cppStandard": "c++23",
            "compilerPath": "${env:MBED_GCC_ARM_PATH}/arm-none-eabi-g++",
            "forcedInclude": [
                "lv_conf.h",
                "lvgl/demos/lv_demos.h"
            ],
            "includePath": [
                "${workspaceFolder}",
                "Core/**",
                "Drivers/**",
                "lvgl/**",
                "fonts/**"
            ],
            "defines": [
                "DEBUG",
                "USE_HAL_DRIVER",
                "USE_FULL_LL_DRIVER",
                "STM32U575xx",
                "I2C_TRACE_LEVEL=0",
                "SMB_TRACE_LEVEL=1",
                "I2C_USE_DMA"
            ]
        }
    ]
}